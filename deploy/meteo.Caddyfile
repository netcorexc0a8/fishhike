# Прокси погоды для FishHike: meteo.wg3664.ru → Open-Meteo.
# Ставится на proxy1 и proxy2 (одинаково). Исходящий трафик к *.open-meteo.com
# уходит через VLESS по правилу Mihomo (см. deploy/mihomo-rules.yaml).
# Сертификат — существующий wildcard *.wg3664.ru (Cloudflare DNS challenge):
# если сайты у тебя описаны внутри общего блока *.wg3664.ru, перенеси
# содержимое как `@meteo host meteo.wg3664.ru` + `handle @meteo { ... }`.

meteo.wg3664.ru {
	# Пропускаем только два нужных пути и только GET — это не открытый прокси.
	@forecast {
		method GET
		path /v1/forecast
	}
	@search {
		method GET
		path /v1/search
	}

	handle @forecast {
		reverse_proxy https://api.open-meteo.com {
			header_up Host {upstream_hostport}
			# Не передаём наружу адрес пользователя.
			header_up -X-Forwarded-For
			header_up -X-Real-IP
			header_down Access-Control-Allow-Origin "https://fishhike.wg3664.ru"
		}
	}

	handle @search {
		reverse_proxy https://geocoding-api.open-meteo.com {
			header_up Host {upstream_hostport}
			header_up -X-Forwarded-For
			header_up -X-Real-IP
			header_down Access-Control-Allow-Origin "https://fishhike.wg3664.ru"
		}
	}

	handle {
		respond 404
	}

	log {
		output stdout
		format console
	}
}
